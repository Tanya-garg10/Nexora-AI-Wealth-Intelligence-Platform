# FEATHERLESS_API_KEY: Required for server-side Featherless AI explanations and Copilot insights.
# Provide your Featherless AI API key here.
FEATHERLESS_API_KEY=""

# APP_URL: The URL where this applet is hosted.
APP_URL="http://localhost:3000"

# ============================================================================
# TRUE MARKETS GATEWAY API CONFIGURATION (Server-Side Only)
# Official documentation: https://docs.truemarkets.co/gateway/quickstart
# ============================================================================

# Option A: Point to your downloaded True Markets API key JSON file (contains key_id and private_key JWK)
TM_KEY_FILE=""

# Option B: Or provide the Organization API Key ID and Private Key JWK directly via environment variables
TRUE_MARKETS_API_KEY_ID=""
TRUE_MARKETS_PRIVATE_KEY_JWK=""

# Optional: Organization ID (automatically extracted from the minted JWT claims.tm.organization_id if omitted)
TRUE_MARKETS_ORGANIZATION_ID=""

# Signer Key (P-256 hex keypair used to stamp user wallet payloads via SIGNATURE_SCHEME_TK_API_P256)
SIGNER_KEY_FILE=""
TRUE_MARKETS_SIGNER_PUBLIC_KEY=""
TRUE_MARKETS_SIGNER_PRIVATE_KEY=""

# Optional: Default True Markets User ID for TM-On-Behalf-Of header
TRUE_MARKETS_USER_ID=""
